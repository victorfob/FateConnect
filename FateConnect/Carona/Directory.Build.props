<Project>

  <!--
    Versão dos quatro projetos da solução de caronas. Fica aqui, e não em cada
    `.csproj`, porque eles sobem juntos: um número repetido quatro vezes é um
    número que diverge na primeira vez que alguém esquece um arquivo.
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
