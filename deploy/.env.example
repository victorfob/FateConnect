# Modelo de um ambiente. Na VPS, copie duas vezes:
#   cp .env.example .env.hml
#   cp .env.example .env.prod
# Estes arquivos não são versionados. Gere os segredos com: openssl rand -base64 32

# ---------- Endereço ----------
# Domínio deste ambiente, sem protocolo. Ex.: fateconnect.com.br
DOMAIN=
# O mesmo endereço, com protocolo. Use http:// na primeira subida; troque para
# https:// depois de rodar o certbot e publique de novo, porque o endereço da
# API fica gravado dentro do front na hora de construí-lo.
PUBLIC_URL=

# Origens extras que a API deve aceitar, além do PUBLIC_URL, separadas por
# vírgula. Serve para desenvolver com o front local apontando para este
# ambiente. Deixe VAZIO em produção: cada origem aqui é um site a mais
# autorizado a falar com a API em nome de quem estiver logado.
CORS_EXTRA_ORIGINS=

# ---------- Portas locais das APIs ----------
# Só o nginx do host as alcança. Use faixas diferentes em cada ambiente:
#   homologação  8101 / 8102
#   produção     8201 / 8202
ACCOUNT_API_PORT=
RIDE_API_PORT=

# ---------- Banco ----------
# O PostgreSQL é o do próprio servidor. O vps-setup.sh cria um banco e um
# usuário por ambiente e grava a senha em /root/senha-<banco>.txt
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------- Token de sessão ----------
# Use segredos DIFERENTES em homologação e produção: um token emitido num não
# pode valer no outro.
JWT_SECRET=
JWT_EXPIRACAO_HORAS=8
JWT_ISSUER=FateConnect
JWT_AUDIENCE=FateConnectWeb

# ---------- Observabilidade (opcional) ----------
VITE_SENTRY_DSN=
