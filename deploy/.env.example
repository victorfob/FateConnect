# Modelo de um AMBIENTE. Na VPS, copie duas vezes:
#   cp .env.example .env.hml
#   cp .env.example .env.prod
# Estes arquivos não são versionados. Gere os segredos com: openssl rand -base64 32

# Endereço público deste ambiente, com protocolo. Precisa ser o mesmo domínio
# que está no edge/.env — um alimenta o front, o outro libera o CORS das APIs.
# Use http:// na primeira subida; o enable-https.sh troca para https:// sozinho.
PUBLIC_URL=

# ---------- Banco (um por ambiente, sem nada em comum) ----------
POSTGRES_DB=fateconnect
POSTGRES_USER=fateconnect
POSTGRES_PASSWORD=

# ---------- Token de sessão ----------
# Use segredos DIFERENTES em homologação e produção: um token emitido num não
# pode valer no outro.
JWT_SECRET=
JWT_EXPIRACAO_HORAS=8
JWT_ISSUER=FateConnect
JWT_AUDIENCE=FateConnectWeb

# ---------- Observabilidade (opcional) ----------
# Deixe vazio para publicar sem enviar erros ao Sentry.
VITE_SENTRY_DSN=
