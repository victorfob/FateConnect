# Configuração de um ambiente no nginx do host. O install-site.sh substitui as
# marcas e instala em /etc/nginx/sites-available.
#
# O HTTPS não está aqui: quem acrescenta os blocos de certificado é o certbot,
# ao rodar com o plugin do nginx. Escrever à mão o que ele gera é como as duas
# configurações divergem na primeira renovação.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMINIO__;

    root /var/www/fateconnect/__AMBIENTE__;
    index index.html;

    access_log /var/log/nginx/fateconnect-__AMBIENTE__.access.log;
    error_log  /var/log/nginx/fateconnect-__AMBIENTE__.error.log;

    location /api/conta/ {
        proxy_pass http://127.0.0.1:__PORTA_CONTA__/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/carona/ {
        proxy_pass http://127.0.0.1:__PORTA_CARONA__/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # O React Router resolve as rotas no navegador: qualquer caminho que não
    # seja arquivo precisa devolver o index, senão recarregar a página dá 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # O bundle traz o hash no nome, então nunca é servido de cache velho; o
    # index não pode ser guardado, senão o navegador continua pedindo o bundle
    # da versão anterior depois de uma publicação.
    location = /index.html {
        add_header Cache-Control "no-store";
    }
}
