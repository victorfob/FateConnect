# Modelo da BORDA. Na VPS: cp .env.example .env
# Este arquivo não é versionado.

# Domínios dos dois ambientes, sem protocolo.
DOMAIN_PROD=
DOMAIN_HML=

# Qual configuração usar: http-only.conf na primeira subida, https.conf depois
# que o enable-https.sh emitir os certificados. O script troca sozinho.
EDGE_CONF=http-only.conf

# E-mail que o Let's Encrypt usa para avisar de expiração.
CERTBOT_EMAIL=
